# Copy to backend/.env and fill in. Only MONGO_URI is required to list posts.
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/blog
PORT=5002
REACT_APP_BACKEND_URL=http://localhost:5002
REACT_APP_FRONTEND_URL=http://localhost:3000
COOKIE_KEY=change-me
TOKEN_SECRET=change-me

# Optional: Google login
GOOGLE_CLIENT=
GOOGLE_SECRET=
# Optional: image uploads (Cloudinary)
CLOUD_NAME=
CLOUD_API_KEY=
CLOUD_API_SECRET=
# Optional: emails (Gmail address + app password)
EMAIL_ID=
PASS=
